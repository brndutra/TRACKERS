.tkrow{padding:12px 0;border-top:1px solid var(--line)}
.tkrow:first-child{border-top:none}
.tkrow .tkh{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.tkrow .tkdot{width:11px;height:11px;border-radius:50%;flex:none}
.tkrow .tknm{font-family:"Hanken Grotesk";font-weight:700;font-size:14px;flex:1;min-width:0}
.tkrow .tkval{font-family:"Space Mono",monospace;font-size:12px;font-weight:700;color:var(--ink)}
.tkrow .tkval small{color:var(--ink-soft);font-weight:400;margin-left:4px}
.tktrack{position:relative;height:30px;border-radius:9px;background:var(--bg);overflow:hidden}
