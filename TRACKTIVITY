<style>
:root{
  --bg:#efe9dc; --paper:#f8f4ea; --ink:#1d2a22; --ink-soft:#5d6b60;
  --line:#e0d8c6; --line-strong:#cdc2aa; --brass:#9a7b3f; --brass-soft:#f0e7d2;
  --pos:#2f6f4e; --pos-soft:#dcebe0; --neg:#a8412f; --neg-soft:#f3ddd5;
  --gold:#c9a227; --green:#1f6b46; --green-soft:#dceae0;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg);color:var(--ink);font-family:"Hanken Grotesk",sans-serif;-webkit-font-smoothing:antialiased}
button,input,select{font-family:inherit;color:inherit;border:none;background:none;outline:none}
button{cursor:pointer}
.wrap{max-width:1180px;margin:0 auto;min-height:100vh;padding:0 0 110px}

header{padding:calc(env(safe-area-inset-top) + 16px) 18px 8px;position:sticky;top:0;background:linear-gradient(var(--bg) 78%,transparent);z-index:20}
.brandline{display:flex;justify-content:space-between;align-items:center}
.eyebrow{font-family:"Space Mono",monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--brass)}
.sync{display:flex;align-items:center;gap:6px;font-family:"Space Mono",monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
.sync .dot{width:7px;height:7px;border-radius:50%;background:var(--brass)}
.sync .dot.on{background:var(--pos)}
.monthnav{display:flex;align-items:center;justify-content:center;gap:10px;margin:10px 0 12px}
.monthnav h1{font-family:"Fraunces",serif;font-weight:500;font-size:25px;letter-spacing:-.01em;min-width:168px;text-align:center}
.navbtn{width:36px;height:36px;border-radius:50%;border:1px solid var(--line-strong);color:var(--ink-soft);font-size:19px;display:grid;place-items:center;background:var(--paper)}
.navbtn:active{background:var(--brass-soft);color:var(--brass)}
.viewtog{margin-left:4px;padding:8px 14px;border-radius:20px;border:1px solid var(--ink);background:var(--paper);font-size:12.5px;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:5px}
.viewtog.on{background:var(--ink);color:var(--paper)}
.tabs{display:flex;gap:3px;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:4px}
.tab{flex:1;padding:9px 2px;border-radius:10px;font-size:12px;font-weight:600;color:var(--ink-soft);transition:.15s}
.tab[aria-selected="true"]{background:var(--ink);color:var(--paper)}

main{padding:22px 16px 0}
.panel{display:none;animation:fade .25s ease}
.panel.on{display:block}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.sec{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-top:12px}
.sec-h{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
.sec-h .t{font-family:"Fraunces",serif;font-size:17px;font-weight:500}
.sec-h .sum{font-family:"Space Mono",monospace;font-size:14px;font-weight:700}
.sum.pos{color:var(--pos)} .sum.neg{color:var(--neg)}
.row{display:flex;justify-content:space-between;align-items:center;padding:10px 2px;border-top:1px solid var(--line)}
.row:first-of-type{border-top:none}
.row .d{font-size:14.5px}
.row .d small{display:block;color:var(--ink-soft);font-size:11.5px;font-family:"Space Mono",monospace;margin-top:1px}
.row .v{font-family:"Space Mono",monospace;font-size:14px;font-weight:700}
.del{color:var(--ink-soft);font-size:12px;padding:4px 6px;border-radius:8px}
.del:active{background:var(--neg-soft);color:var(--neg)}
.row .d2{display:flex;align-items:center;gap:9px;flex-wrap:wrap;min-width:0}
.catpill{font-size:11px;font-weight:700;color:#fff;padding:3px 9px;border-radius:20px;white-space:nowrap;line-height:1.3}
.desig{display:flex;align-items:center;gap:6px;font-size:14.5px;min-width:0}
.desig em{font-style:normal;font-family:"Space Mono",monospace;font-size:10px;color:var(--ink-soft);border:1px solid var(--line-strong);border-radius:10px;padding:1px 6px;margin-left:2px}
.sdot{width:9px;height:9px;border-radius:50%;flex:none;display:inline-block}
.row .rv{display:flex;align-items:center;flex:none}
.cattog{cursor:pointer}
.cattog .chev{color:var(--ink-soft);font-size:12px;margin-left:2px}
.subrow{display:flex;align-items:center;gap:8px;padding:5px 2px 5px 40px;font-size:12.5px;color:var(--ink-soft)}
.subrow .sn{flex:1}
.subrow .sv{font-family:"Space Mono",monospace;font-weight:700;font-size:12px;color:var(--ink)}
/* tabelas detalhadas (compromissos/parcelas/faturas) */
.ctblwrap{overflow-x:auto;margin-top:8px;border:1px solid var(--line);border-radius:12px}
.ctbl{border-collapse:collapse;width:100%;min-width:0;font-size:12px}
.ctbl th,.ctbl td{padding:8px 9px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
.ctbl th{background:var(--ink);color:var(--paper);font-family:"Hanken Grotesk";font-weight:600;font-size:10.5px}
.ctbl th.num,.ctbl td.num{text-align:right;font-family:"Space Mono",monospace}
.ctbl td.num{font-weight:700}
.ctbl tr.ctot td{font-weight:700;background:var(--brass-soft);border-bottom:none}
.ctbl .cempty{color:var(--ink-soft);text-align:center;padding:14px 4px}
.ctbl .editlink{color:var(--brass);font-weight:700;font-size:11px;padding:3px 7px;border-radius:7px}
.ctbl .editlink:active{background:var(--brass-soft)}
.dayin{width:48px;padding:5px;border:1px solid var(--line-strong);border-radius:8px;background:var(--brass-soft);text-align:center;font-family:"Space Mono",monospace;font-size:13px;font-weight:700}
.pwrap{display:flex;align-items:center;gap:7px;min-width:96px}
.pwrap .pbar{flex:1;height:7px;border-radius:4px;background:var(--line);overflow:hidden}
.pwrap .pbar i{display:block;height:100%;background:linear-gradient(90deg,var(--brass),var(--gold))}
.pwrap span{font-family:"Space Mono",monospace;font-size:11px;font-weight:700;color:var(--ink-soft)}
.ctbl td small{display:block;color:var(--ink-soft);font-size:9.5px;font-weight:400}
.catdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:1px}
.ctbl .rectag{font-style:normal;font-size:9px;color:var(--brass);font-family:"Space Mono",monospace}
.ctbl.grouped tr.grow td{background:color-mix(in srgb,var(--gc) 15%,var(--paper));font-weight:700;color:var(--ink);border-top:2px solid var(--paper);border-bottom:1px solid color-mix(in srgb,var(--gc) 35%,transparent)}
.ctbl.grouped tr.grow td:first-child{border-left:3px solid var(--gc)}
.ctbl.grouped tr.grow .gic{margin-right:6px}
.ctbl.grouped tr.erowx td:first-child{border-left:3px solid color-mix(in srgb,var(--gc) 38%,transparent)}
.ctbl.grouped tr.ctot td{background:var(--ink);color:#fff;font-weight:700}
.ctbl.grouped tr.ctot td.num{color:#fff}
.ctbl.fam{--bc:#9a8f78}
.ctbl.fam tr.gband td{padding:0;border:none}
.ctbl.fam .gbandinner{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;background:linear-gradient(90deg,var(--bc),color-mix(in srgb,var(--bc) 68%,white));color:#fff;font-weight:800;letter-spacing:.06em;text-transform:uppercase;font-size:12.5px}
.ctbl.fam .gbandinner b{font-family:"Space Mono",monospace;font-size:13px;letter-spacing:0}
.ctbl.fam tr.grow td{background:color-mix(in srgb,var(--gc) 30%,var(--paper));font-weight:700;color:var(--ink);border-top:2px solid var(--paper);border-bottom:1px solid color-mix(in srgb,var(--gc) 50%,transparent)}
.ctbl.fam tr.grow td:first-child{border-left:12px solid var(--gc)}
.ctbl.fam tr.erowx td:first-child{border-left:12px solid color-mix(in srgb,var(--gc) 60%,white)}
.ctbl.fam tr.erowx td{background:color-mix(in srgb,var(--gc) 7%,var(--paper))}
.ctbl.fam tr.ctot td{background:var(--ink);color:#fff}
.ctbl.fam .catdot{box-shadow:0 0 0 3px color-mix(in srgb,var(--gc) 22%,transparent)}
.ctbl.fam tr.folha td{opacity:.82;font-style:italic}
.ctbl.fam tr.folhanote td{background:var(--paper);color:var(--ink-soft);font-size:11px;padding:8px 12px;border-left:12px solid color-mix(in srgb,var(--bc) 40%,white)}
/* ---- Planilha única (ledger) ---- */
.ledger{border-right:5px solid var(--pos);border-radius:16px;overflow:hidden;border:1px solid var(--line)}
.ctbl.fam2{border:none}
.ctbl.fam2 tr.gband td{padding:0;border:none}
.ctbl.fam2 .gbandinner{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;background:linear-gradient(90deg,var(--secc),color-mix(in srgb,var(--secc) 68%,white));color:#fff;font-weight:800;letter-spacing:.06em;text-transform:uppercase;font-size:12.5px}
.ctbl.fam2 .gbandinner b{font-family:"Space Mono",monospace;font-size:13px;letter-spacing:0}
.ctbl.fam2 tr.grow td{background:var(--bg);font-weight:700;color:var(--ink);border-top:none;border-bottom:1px solid var(--line)}
.ctbl.fam2 tr.grow td:first-child{border-left:4px solid var(--gc)}
.ctbl.fam2 tr.erowx td{background:var(--paper)}
.ctbl.fam2 tr.erowx td:first-child{border-left:4px solid color-mix(in srgb,var(--gc) 50%,white)}
.ctbl.fam2 tr.erowx.folha td{opacity:.82;font-style:italic}
.ctbl.fam2 tr.ctot td{background:var(--ink);color:#fff;font-weight:700}
.ctbl.fam2 tr.ctot.final td{background:var(--neg);color:#fff;font-size:13px}
.ctbl.fam2 .catdot{box-shadow:0 0 0 3px color-mix(in srgb,var(--gc) 22%,transparent)}
.ctbl.fam2 tr.folhanote td{background:var(--bg);color:var(--ink-soft);font-size:11px;padding:8px 12px}
.vedit{float:right;font-family:"Hanken Grotesk",sans-serif;font-size:12px;font-weight:600;color:var(--brass);background:var(--brass-soft);border:1px solid color-mix(in srgb,var(--brass) 40%,transparent);border-radius:999px;padding:3px 11px}
.vedit.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.tl th.dur,.tl td.dur{position:sticky;right:0;background:var(--paper);text-align:right;padding-left:14px;border-left:1px solid var(--line-strong);white-space:nowrap;font-size:11px;color:var(--ink-soft)}
.tl td.dur b{font-family:"Space Mono",monospace;color:var(--ink);font-size:13px}
.tl td.dur small{display:block;font-size:9.5px}
.empty{font-size:13px;color:var(--ink-soft);padding:12px 2px;line-height:1.5}
.addbtn{display:block;width:100%;margin-top:8px;padding:11px;border-radius:11px;border:1.5px dashed var(--line-strong);color:var(--ink-soft);font-weight:700;font-size:13.5px;background:transparent}
.addbtn:active{border-color:var(--brass);color:var(--brass)}
.lancbtn{position:absolute;left:50%;bottom:0;transform:translate(-50%,50%);background:var(--brass);color:#fff;font-weight:700;font-size:13px;padding:9px 20px;border-radius:22px;box-shadow:0 4px 14px rgba(154,123,63,.35);z-index:25}
.lancbtn:active{background:#856a35}
/* linhas de lançamento com colunas */
.erow{padding:11px 2px;border-top:1px solid var(--line)}
.erow:first-of-type{border-top:none}
.ehead{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.ehead .desig{flex:1}
.ehead .del{margin-left:auto}
.ecols{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.ecols .col{flex:1 1 auto;min-width:64px;background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:5px 8px}
.ecols .cl{display:block;font-family:"Space Mono",monospace;font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft)}
.ecols .cvv{display:block;font-family:"Space Mono",monospace;font-size:12px;font-weight:700;margin-top:1px}

.balance{background:var(--ink);color:var(--paper);border-radius:18px;padding:18px 20px;margin-top:12px}
.balance .lbl{font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.7}
.balance .big{font-family:"Fraunces",serif;font-size:33px;font-weight:500;margin-top:4px;letter-spacing:-.01em}
.balance .brk{display:flex;gap:16px;margin-top:12px;flex-wrap:wrap}
.balance .brk span{font-family:"Space Mono",monospace;font-size:11.5px;opacity:.82}
.balance .brk b{display:block;font-size:14px;opacity:1;margin-top:2px}

/* Anual */
.annual{margin-top:12px;border:1px solid var(--line);border-radius:14px;background:var(--paper);overflow:hidden}
.annual table{border-collapse:collapse;font-family:"Space Mono",monospace;font-size:10px;width:100%;min-width:0;table-layout:fixed}
.annual th,.annual td{padding:7px 3px;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border-bottom:1px solid var(--line)}
.annual th:first-child,.annual td:first-child{text-align:left;position:sticky;left:0;background:var(--paper);font-family:"Hanken Grotesk";font-weight:700;font-size:11px;width:74px}
.annual thead th{background:var(--ink);color:var(--paper);font-family:"Hanken Grotesk";font-weight:600;font-size:10px}
.annual thead th:first-child{background:var(--ink);color:var(--paper)}
.annual tr.tot td{font-weight:700;background:var(--brass-soft)}
.annual tr.tot td:first-child{background:var(--brass-soft)}
.pos-c{color:var(--pos)} .neg-c{color:var(--neg)}

.fmonth{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-top:10px;display:flex;align-items:center;gap:12px}
.fmonth .name{font-family:"Fraunces",serif;font-size:15px;min-width:74px}
.fmonth .bars{flex:1}
.fbar{height:7px;border-radius:4px;background:var(--line);overflow:hidden;margin-top:6px}
.fbar i{display:block;height:100%}
.fmonth .free{text-align:right;min-width:92px}
.fmonth .free .n{font-family:"Space Mono",monospace;font-weight:700;font-size:14px}
.fmonth .free small{display:block;font-size:10px;color:var(--ink-soft);font-family:"Space Mono",monospace}
.fmonth .fcomp{font-family:"Space Mono",monospace;font-size:9.5px;color:var(--ink-soft);margin-top:4px;letter-spacing:.02em}
.intro{font-size:13px;color:var(--ink-soft);margin:4px 4px 0;line-height:1.55}

.plan{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:15px 16px;margin-top:12px}
.plan.off{opacity:.5}
.plan .ph{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.plan .ph .ttl{font-family:"Fraunces",serif;font-size:18px;font-weight:500;line-height:1.15}
.plan .ph .tag{font-family:"Space Mono",monospace;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--brass);margin-top:3px}
.plan .total{font-family:"Space Mono",monospace;font-weight:700;font-size:15px;text-align:right;white-space:nowrap}
.plan .total small{display:block;color:var(--ink-soft);font-weight:400;font-size:11px;margin-top:1px}
.plan .impact{margin-top:12px;padding-top:11px;border-top:1px dashed var(--line-strong);font-size:13px;color:var(--ink-soft);line-height:1.5}
.plan .impact b{color:var(--ink);font-family:"Space Mono",monospace}
.plan .pacts{display:flex;gap:8px;margin-top:12px}
.plan .pacts button{flex:1;padding:9px;border-radius:10px;font-size:12.5px;font-weight:700;border:1px solid var(--line-strong);color:var(--ink-soft)}
.plan .pacts .on-b{background:var(--pos-soft);color:var(--pos);border-color:transparent}

/* viagem */
.vtrip{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:15px 16px;margin-top:12px}
.vtrip.off{opacity:.55}
.vth{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.vth .vtt{font-family:"Fraunces",serif;font-size:19px;font-weight:500;line-height:1.1}
.vth .vsub{font-family:"Space Mono",monospace;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--brass);margin-top:3px}
.vth .vtotal{font-family:"Space Mono",monospace;font-weight:700;font-size:16px;text-align:right;white-space:nowrap}
.vth .vtotal small{display:block;color:var(--ink-soft);font-weight:400;font-size:11px;margin-top:1px}
.vversions{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}
.vpill{padding:7px 11px;border-radius:11px;border:1px solid var(--line-strong);font-size:12px;font-weight:600;color:var(--ink-soft);text-align:left;line-height:1.2}
.vpill small{display:block;font-family:"Space Mono",monospace;font-size:10px;font-weight:400;margin-top:1px}
.vpill.on{background:var(--ink);color:var(--paper);border-color:transparent}
.vpill.on small{color:var(--paper);opacity:.8}
.vnew{padding:7px 11px;border-radius:11px;border:1.5px dashed var(--line-strong);font-size:12px;font-weight:700;color:var(--ink-soft)}
.vsection{font-family:"Fraunces",serif;font-size:14px;font-weight:600;margin:16px 0 6px}
.yearbar{display:flex;align-items:center;justify-content:space-between;margin:16px 0 6px;gap:10px}
.yearpick{display:flex;align-items:center;gap:8px;font-family:"Space Mono",monospace;font-size:14px;font-weight:700}
.yearpick button{width:30px;height:30px;border-radius:50%;border:1px solid var(--line-strong);color:var(--ink-soft);font-size:16px;display:grid;place-items:center;background:var(--paper)}
.yearpick button:active{background:var(--brass-soft);color:var(--brass)}
.vtable{width:100%;border-collapse:collapse;font-size:13px}
.vtable th{font-family:"Space Mono",monospace;font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);text-align:left;padding:4px 6px;border-bottom:1px solid var(--line-strong)}
.vtable th:last-child,.vtable td:last-child{width:26px}
.vtable td{padding:8px 6px;border-bottom:1px solid var(--line);vertical-align:top}
.vtable td.dia{font-family:"Fraunces",serif;font-weight:600;color:var(--brass);width:30px}
.vtable td.num{font-family:"Space Mono",monospace;font-weight:700;text-align:right;white-space:nowrap}
.vtable th:nth-child(3){text-align:right}
.vtable tfoot td{font-weight:700;border-bottom:none;border-top:1px solid var(--line-strong);background:var(--bg)}
.vtable .vempty{color:var(--ink-soft);font-size:12px;text-align:center;padding:12px 4px}
.trash{color:var(--ink-soft);font-size:16px;line-height:1;padding:2px 5px;border-radius:6px}
.trash:active{background:var(--neg-soft);color:var(--neg)}
.addmini{display:block;width:100%;margin-top:8px;padding:9px;border-radius:10px;border:1.5px dashed var(--line-strong);color:var(--ink-soft);font-weight:700;font-size:12.5px;background:transparent}
.addmini:active{border-color:var(--brass);color:var(--brass)}
.vgrand{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding:11px 13px;border-radius:12px;background:var(--ink);color:var(--paper)}
.vgrand span{font-size:13px;opacity:.85}
.vgrand b{font-family:"Space Mono",monospace;font-size:16px}

/* linha do tempo de compromissos */
.tlwrap{overflow-x:auto;margin-top:8px;border:1px solid var(--line);border-radius:14px;background:var(--paper)}
.tl{border-collapse:collapse;font-size:10px;width:100%;min-width:0}
.tl th,.tl td{padding:6px 3px;text-align:center;border-bottom:1px solid var(--line);min-width:38px}

/* compromissos lado a lado */
.twocol{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;margin-top:12px}
.twocol>.sec{flex:1 1 280px;margin-top:0}
.commit-grid{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;margin-top:12px}
.commit-left{flex:0 0 268px;max-width:300px;height:498px;overflow-y:auto;display:flex;flex-direction:column;gap:12px;padding-right:2px}
.commit-left .sec{margin-top:0}
.commit-left .addbtn{margin-top:0}
.commit-right{flex:1 1 360px;min-width:0}
.commit-right .vsection{margin-top:0}
.commit-right .tlwrap{height:498px;overflow:auto;margin-top:8px}
@media (max-width:680px){
  .commit-left{flex:1 1 100%;max-width:none;height:auto;overflow:visible}
  .commit-right{flex:1 1 100%}
  .commit-right .tlwrap{height:auto;max-height:420px}
}
.tl thead th{font-family:"Space Mono",monospace;font-size:9px;color:var(--ink-soft);font-weight:400;line-height:1.1}
.tl thead th small{display:block;opacity:.6}
.tl th:first-child,.tl td.nm{position:sticky;left:0;background:var(--paper);text-align:left;min-width:108px;font-family:"Hanken Grotesk";font-size:11.5px;font-weight:600;z-index:1}
.tl td.nm small{display:block;font-family:"Space Mono",monospace;font-weight:400;color:var(--ink-soft);font-size:10px}
.cellbar{display:block;height:14px;border-radius:4px;margin:0 1px}
.cellbar.consignado{background:#a8412f}
.cellbar.parcelamento{background:var(--brass)}
.cellbar.end{border-right:3px solid var(--ink);border-radius:4px 2px 2px 4px}
.tl tr.totrow td{border-top:2px solid var(--line-strong);background:var(--bg)}
.tl tr.totrow td.tv{font-family:"Space Mono",monospace;font-weight:700;font-size:10px}
.tl tr.totrow td.nm{background:var(--bg)}
.tl tr.saldo td{background:var(--paper);border-top:1px solid var(--line-strong)}
.tl tr.saldo td.nm{background:var(--paper)}
.cleg{display:flex;gap:14px;margin-top:8px;font-size:11px;color:var(--ink-soft);font-family:"Space Mono",monospace;flex-wrap:wrap}
.cleg span{display:flex;align-items:center;gap:5px}
.cleg i{width:12px;height:12px;border-radius:3px;display:inline-block}
.editlink{color:var(--brass);font-size:11px;font-weight:700;padding:3px 6px;border-radius:7px}
.editlink:active{background:var(--brass-soft)}

/* metas painel */
.mblock{margin-top:8px}
.mlabel{font-family:"Space Mono",monospace;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--brass);margin:14px 2px 4px}
.metacard{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:13px 15px;margin-top:8px}
.mch{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.mch .mic{font-size:17px}
.mch .mtt{font-family:"Fraunces",serif;font-size:15px;font-weight:500;flex:1}
.mch .mtag{font-family:"Space Mono",monospace;font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-soft);border:1px solid var(--line-strong);border-radius:20px;padding:2px 8px}
.mmet{font-size:12px;color:var(--ink-soft);line-height:1.5;margin-top:8px;padding-top:8px;border-top:1px dashed var(--line-strong)}
/* board */
.boardcard{position:relative}
.rmboard{position:absolute;top:10px;right:12px;width:26px;height:26px;border-radius:50%;border:1px solid var(--line-strong);color:var(--ink-soft);font-size:15px;line-height:1;background:var(--paper);z-index:2}
.rmboard:active{background:var(--neg-soft);color:var(--neg)}
.pickitem{display:flex;align-items:center;gap:11px;padding:12px 4px;border-top:1px solid var(--line)}
.pickitem:first-child{border-top:none}
.pickitem .pic{font-size:19px}
.pickitem .pn{flex:1;font-size:14.5px}
.pickitem button{padding:7px 13px;border-radius:9px;font-size:12.5px;font-weight:700;border:1px solid var(--line-strong);color:var(--ink-soft)}
.pickitem.has button{background:var(--pos-soft);color:var(--pos);border-color:transparent}

/* ===== DESAFIOS ===== */
.quest{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:15px 16px;margin-top:12px}
.quest .qh{display:flex;align-items:center;gap:10px;margin-bottom:4px}
.quest .qh .ic{font-size:20px}
.quest .qh .qt{font-family:"Fraunces",serif;font-size:17px;font-weight:500}
.quest .qsub{font-size:12.5px;color:var(--ink-soft);line-height:1.5;margin-bottom:10px}
.bar{height:12px;border-radius:7px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--brass),var(--gold))}
.qmeta{display:flex;justify-content:space-between;font-family:"Space Mono",monospace;font-size:12px;margin-top:7px;color:var(--ink-soft)}
.qmeta b{color:var(--ink)}

/* passaporte grid */
.passport{display:grid;grid-template-columns:repeat(12,1fr);gap:4px;margin-top:12px}
.cell{aspect-ratio:1;border-radius:4px;border:1px solid var(--line-strong);background:var(--paper)}
.cell.f{background:var(--gold);border-color:var(--gold)}
.stepper{display:flex;gap:8px;margin-top:12px}
.stepper button{flex:1;padding:10px;border-radius:10px;font-weight:700;font-size:13px;border:1px solid var(--line-strong);color:var(--ink-soft)}
.stepper button.go{background:var(--ink);color:var(--paper);border-color:transparent}

/* dívidas / liberar renda */
.debt{display:flex;align-items:center;gap:11px;padding:11px 0;border-top:1px solid var(--line)}
.debt:first-of-type{border-top:none}
.debt .dot{width:12px;height:12px;border-radius:50%;background:var(--neg);flex:none}
.debt.done .dot{background:var(--pos)}
.debt .dn{flex:1;font-size:14px}
.debt .dn small{display:block;font-family:"Space Mono",monospace;color:var(--ink-soft);font-size:11.5px}
.debt.done .dn{text-decoration:line-through;color:var(--ink-soft)}
.debt .dv{font-family:"Space Mono",monospace;font-weight:700;font-size:13.5px}
.debt button{padding:7px 11px;border-radius:9px;border:1px solid var(--line-strong);font-size:12px;font-weight:700;color:var(--ink-soft)}
.debt.done button{background:var(--pos-soft);color:var(--pos);border-color:transparent}
.libpanel{display:flex;gap:10px;margin-top:12px}
.libpanel div{flex:1;border-radius:12px;padding:11px;text-align:center}
.libpanel .presa{background:var(--neg-soft)}
.libpanel .livre{background:var(--pos-soft)}
.libpanel .lbl{font-family:"Space Mono",monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft)}
.libpanel .n{font-family:"Space Mono",monospace;font-weight:700;font-size:16px;margin-top:3px}

/* o que posso comprar */
.calc input{width:100%;padding:13px;border-radius:11px;border:1px solid var(--line-strong);background:var(--bg);font-size:16px;font-family:"Space Mono",monospace;margin-top:10px}
.verdict{margin-top:12px;border-radius:12px;padding:13px 14px;font-size:14px;font-weight:600;display:none;line-height:1.45}
.verdict.show{display:block}
.verdict.g{background:var(--pos-soft);color:var(--pos)}
.verdict.y{background:#fbf0cf;color:#8a6d12}
.verdict.r{background:var(--neg-soft);color:var(--neg)}
.zhint{display:flex;gap:6px;margin-top:10px;font-size:11px;font-family:"Space Mono",monospace}
.zhint span{flex:1;padding:7px;border-radius:8px;text-align:center}
.zhint .zg{background:var(--pos-soft);color:var(--pos)} .zhint .zy{background:#fbf0cf;color:#8a6d12} .zhint .zr{background:var(--neg-soft);color:var(--neg)}

/* trackers */
.daygrid{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-top:12px}
.day{aspect-ratio:1;border-radius:7px;border:1px solid var(--line-strong);display:grid;place-items:center;font-family:"Space Mono",monospace;font-size:11px;color:var(--ink-soft);background:var(--paper)}
.day.on{background:var(--pos);color:#fff;border-color:transparent}
.medals{display:flex;gap:8px;margin-top:12px}
.medal{flex:1;border-radius:12px;border:1px solid var(--line-strong);padding:11px 6px;text-align:center;opacity:.4}
.medal.win{opacity:1;background:var(--brass-soft);border-color:var(--brass)}
.medal .em{font-size:22px}
.medal .ml{font-size:11px;font-family:"Space Mono",monospace;margin-top:3px}

/* score */
.scorebig{font-family:"Fraunces",serif;font-size:40px;font-weight:500;text-align:center;margin:6px 0 2px}
.level{text-align:center;font-family:"Space Mono",monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--brass)}
.ladder{display:flex;justify-content:space-between;margin:12px 0;font-size:9.5px;font-family:"Space Mono",monospace;color:var(--ink-soft);gap:2px}
.ladder span{flex:1;text-align:center;padding:4px 2px;border-radius:6px}
.ladder span.now{background:var(--ink);color:var(--paper)}
.scoreacts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.scoreacts button{padding:11px 8px;border-radius:11px;border:1px solid var(--line-strong);font-size:12px;font-weight:600;color:var(--ink);text-align:left;line-height:1.3}
.scoreacts button b{color:var(--brass);font-family:"Space Mono",monospace}
.scoreacts button:active{background:var(--brass-soft)}

/* habitos */
.habit{display:flex;align-items:center;gap:11px;padding:10px 0;border-top:1px solid var(--line)}
.habit:first-of-type{border-top:none}
.habit .box{width:22px;height:22px;border-radius:6px;border:1.5px solid var(--line-strong);flex:none;display:grid;place-items:center;font-size:13px;color:transparent}
.habit.on .box{background:var(--pos);border-color:transparent;color:#fff}
.habit .ht{flex:1;font-size:14px}
.habit.on .ht{color:var(--ink-soft)}
.habit .he{font-family:"Space Mono",monospace;font-size:12px;color:var(--pos);font-weight:700}

/* dicas */
.tip{background:transparent;border:none;border-top:1px solid var(--line);border-radius:0;padding:16px 2px 6px;margin-top:18px;position:relative}
.tip::before{content:"";position:absolute;top:-1px;left:0;width:34px;height:2px;background:var(--brass)}
.tip .tt{font-family:"Fraunces",serif;font-size:16px;font-weight:600;color:var(--ink);display:flex;align-items:baseline;gap:8px;letter-spacing:-.01em}
.tip .tb{font-size:13px;color:var(--ink-soft);line-height:1.6;margin-top:6px}
.tip .tb b{color:var(--ink);font-weight:600}
.tip.gold::before{background:var(--gold)}
.tip.gold .tt{color:var(--ink)}
.split503020{display:flex;gap:6px;margin-top:9px}
.split503020 span{flex:1;text-align:center;font-family:"Space Mono",monospace;font-size:11px;padding:7px 4px;border-radius:8px;line-height:1.3}
.s50{background:var(--pos-soft);color:var(--pos)} .s30{background:#fbf0cf;color:#8a6d12} .s20{background:#dde7f3;color:#2e5c8a}
/* categorias */
.catwrap{margin-top:6px}
.catrow{display:flex;align-items:center;gap:10px;padding:9px 2px;border-top:1px solid var(--line)}
.catrow:first-of-type{border-top:none}
.catico{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-size:15px;color:#fff;flex:none}
.catrow .cn{flex:1;font-size:14px}
.catrow .cbar{flex:1.4;height:8px;border-radius:5px;background:var(--line);overflow:hidden}
.catrow .cbar i{display:block;height:100%}
.catrow .cv{font-family:"Space Mono",monospace;font-weight:700;font-size:13px;min-width:74px;text-align:right}

/* modal */
.modal{position:fixed;inset:0;z-index:60;display:none;align-items:flex-end;justify-content:center}
.modal.on{display:flex}
.modal .scrim{position:absolute;inset:0;background:rgba(16,28,24,.45)}
.sheet{position:relative;width:100%;max-width:560px;background:var(--bg);border-radius:24px 24px 0 0;padding:8px 20px calc(24px + env(safe-area-inset-bottom));max-height:90vh;overflow:auto;animation:up .3s cubic-bezier(.2,.7,.2,1)}
@keyframes up{from{transform:translateY(100%)}to{transform:none}}
.grip{width:38px;height:4px;border-radius:2px;background:var(--line-strong);margin:8px auto 16px}
.sheet h3{font-family:"Fraunces",serif;font-weight:500;font-size:22px;margin-bottom:14px}
.fr{margin-bottom:12px}
.fr label{display:block;font-size:12px;font-weight:600;color:var(--ink-soft);margin-bottom:5px}
.fr input,.fr select{width:100%;padding:12px;border-radius:11px;border:1px solid var(--line-strong);background:var(--paper);font-size:15px}
.two{display:flex;gap:10px}.two .fr{flex:1}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{flex:1;min-width:72px;padding:10px;border-radius:10px;border:1px solid var(--line-strong);font-size:12.5px;font-weight:600;color:var(--ink-soft)}
.seg button.on{background:var(--ink);color:var(--paper);border-color:transparent}
.btn{width:100%;padding:13px;border-radius:12px;background:var(--brass);color:#fff;font-weight:700;font-size:15px;margin-top:4px}
.btn.ghost{background:transparent;color:var(--ink-soft);border:1px solid var(--line-strong);margin-top:8px}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}

/* ===== aneox logo + girar (habit tracker) ===== */
.logoaneox{display:flex;justify-content:center;align-items:center;margin:7px 0 3px}
.logoaneox img{height:50px;width:auto;display:block}
.spinbtn{width:36px;height:36px;border-radius:50%;border:1px solid var(--line-strong);color:var(--ink-soft);font-size:18px;display:grid;place-items:center;background:var(--paper);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.spinbtn:active{background:var(--brass-soft);color:var(--brass)}
html.habit .spinbtn{border-color:color-mix(in srgb,var(--pos) 45%,var(--line-strong));color:var(--pos);background:var(--pos-soft)}
#flipzone{transform-origin:top center;will-change:transform;backface-visibility:hidden}

/* habit mode: verde escuro -> laranja */
html.habit{--pos:#c2611f;--pos-soft:#f7e3d2;--green:#b4521c;--green-soft:#f8e7d8;--gold:#d98a2b}

/* habit app */
#habitApp{display:none}
.hcard{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-top:12px}
.hhead{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
.hhead .hspark{flex:1 1 200px;min-width:150px}
.hhead .hspark .sl{font-family:"Space Mono",monospace;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);display:flex;justify-content:space-between;margin-bottom:8px}
.hhead .hring{flex:none}
.hhead .htot{flex:none;text-align:right;min-width:92px}
.hhead .htot .n{font-family:"Fraunces",serif;font-size:30px;font-weight:500;line-height:1}
.hhead .htot small{display:block;font-family:"Space Mono",monospace;font-size:10px;color:var(--ink-soft);margin-top:3px}
.hsheet{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--paper);margin-top:12px;-webkit-overflow-scrolling:touch}
table.hgrid{border-collapse:collapse;font-size:11px;width:100%}
.hgrid th,.hgrid td{border-bottom:1px solid var(--line);text-align:center}
.hgrid th.nm,.hgrid td.nm{position:sticky;left:0;background:var(--paper);text-align:left;padding:8px 11px;min-width:152px;font-family:"Hanken Grotesk";font-weight:600;font-size:12px;z-index:2;border-right:1px solid var(--line-strong)}
.hgrid thead th.nm{z-index:3}
.hgrid thead th{font-family:"Space Mono",monospace;font-weight:700;font-size:9px;color:var(--ink-soft);padding:5px 0;white-space:nowrap}
.hgrid th.wk{text-transform:uppercase;letter-spacing:.07em;color:#fff;background:var(--wc);font-size:9px;padding:6px 4px}
.hgrid th.dcol{min-width:23px;background:color-mix(in srgb,var(--wc) 9%,var(--paper))}
.hgrid th.dcol .dl{display:block;font-size:8px;opacity:.6;font-weight:400}
.hgrid th.dcol .dn{display:block;font-size:9.5px;font-weight:700;color:var(--ink)}
.hgrid td.cell{padding:3px;background:color-mix(in srgb,var(--wc) 5%,var(--paper))}
.hbox{width:16px;height:16px;border-radius:4px;border:1.5px solid var(--line-strong);background:var(--paper);display:block;margin:0 auto;position:relative;cursor:pointer}
.hbox.on{background:var(--pos);border-color:transparent}
.hbox.on::after{content:"";position:absolute;left:5px;top:1.5px;width:4px;height:8px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(42deg)}
.hgrid td.goalc{font-family:"Space Mono",monospace;font-weight:700;font-size:11px;padding:0 8px;color:var(--ink-soft);border-left:1px solid var(--line-strong)}
.hgrid td.progc{padding:6px 10px;min-width:122px}
.hgrid th.goalh,.hgrid th.progh{border-left:1px solid var(--line-strong);padding:0 8px}
.hprog{display:flex;align-items:center;gap:8px}
.hprog .hbar{flex:1;height:7px;border-radius:4px;background:var(--line);overflow:hidden;min-width:46px}
.hprog .hbar i{display:block;height:100%;background:linear-gradient(90deg,var(--brass),var(--pos))}
.hprog span{font-family:"Space Mono",monospace;font-size:10px;font-weight:700;color:var(--ink-soft);white-space:nowrap}
.hgrid tr.addrow td{padding:9px 11px;text-align:left;background:var(--paper)}
.hadd{font-family:"Hanken Grotesk";font-weight:700;font-size:12px;color:var(--ink-soft);cursor:pointer}
.hadd:active{color:var(--brass)}
.hdel{color:var(--line-strong);font-size:11px;margin-left:7px;cursor:pointer;font-family:"Hanken Grotesk"}
.hdel:hover{color:var(--neg)}
.hweeks{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.hweekc{flex:1 1 110px;text-align:center;border:1px solid var(--line);border-radius:12px;padding:12px 8px;background:var(--bg)}
.hweekc .wl{font-family:"Space Mono",monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
.hweekc .wc2{font-family:"Space Mono",monospace;font-size:9.5px;color:var(--ink-soft);margin-top:8px}
.hweekc .wc2 b{color:var(--ink)}
.hwkgrid{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.hwkcol{flex:1 1 142px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.hwkh{padding:8px 11px;color:#fff;font-family:"Space Mono",monospace;font-size:9.5px;text-transform:uppercase;letter-spacing:.07em;font-weight:700;background:var(--wc)}
.hwkitem{display:flex;align-items:center;gap:9px;padding:9px 11px;border-top:1px solid var(--line);font-size:12.5px;cursor:pointer}
.hwkitem .box{width:18px;height:18px;border-radius:5px;border:1.5px solid var(--line-strong);flex:none;display:grid;place-items:center;font-size:11px;color:transparent}
.hwkitem.on .box{background:var(--pos);border-color:transparent;color:#fff}
.hwkitem.on{color:var(--ink-soft)}
.hnotes{width:100%;min-height:88px;resize:vertical;padding:12px 13px;border-radius:12px;border:1px solid var(--line-strong);background:var(--paper);font-family:"Hanken Grotesk";font-size:13.5px;line-height:1.55;color:var(--ink)}
.hsub{font-family:"Space Mono",monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--pos);margin:20px 2px 2px}
.hintro{font-size:13px;color:var(--ink-soft);margin:6px 4px 0;line-height:1.55}

/* ===== Centro de Comando Cognitivo (lado habit) ===== */
.cctitle{display:flex;align-items:center;gap:11px;margin:30px 2px 0}
.cctitle .t{font-family:"Fraunces",serif;font-size:21px;font-weight:500;letter-spacing:-.01em}
.cctitle .e{font-family:"Space Mono",monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--pos)}
.cctitle .ln{flex:1;height:1px;background:var(--line-strong)}
.chelp{font-size:12.5px;color:var(--ink-soft);margin:5px 4px 0;line-height:1.5}
.ctx{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:700;font-family:"Hanken Grotesk";padding:3px 9px;border-radius:20px;color:#fff;white-space:nowrap;line-height:1.3}
.ctx .ci{font-size:11px}
.ccnow{margin-top:10px;border-radius:18px;padding:18px;color:#fff;background:linear-gradient(135deg,var(--pos),color-mix(in srgb,var(--pos) 60%,#6e2806))}
.ccnow .lab{font-family:"Space Mono",monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;opacity:.85}
.ccnow .ti{font-family:"Fraunces",serif;font-size:23px;font-weight:500;line-height:1.15;margin:7px 0 4px}
.ccnow .nx{font-size:14px;line-height:1.5;opacity:.96}
.ccnow .nx b{font-weight:700}
.ccnow .meta{display:flex;align-items:center;gap:10px;margin-top:14px;flex-wrap:wrap}
.ccnow .when{font-family:"Space Mono",monospace;font-size:10.5px;opacity:.82}
.ccnow .act{display:flex;gap:8px;margin-left:auto}
.ccbtn{font-family:"Hanken Grotesk";font-weight:700;font-size:12.5px;padding:8px 13px;border-radius:11px;background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.32)}
.ccbtn:active{background:rgba(255,255,255,.28)}
.ccbtn.solid{background:#fff;color:var(--pos);border-color:#fff}
.ccempty{font-size:13px;color:var(--ink-soft);padding:16px;text-align:center;border:1px dashed var(--line-strong);border-radius:14px;margin-top:10px}
.ccrow{display:flex;align-items:flex-start;gap:12px;padding:13px 15px;border:1px solid var(--line);border-radius:14px;background:var(--paper);margin-top:9px}
.ccrow .body{flex:1;min-width:0}
.ccrow .ti{font-size:14.5px;font-weight:600;margin-bottom:2px}
.ccrow .nx{font-size:12.5px;color:var(--ink-soft);line-height:1.45}
.ccrow .nx b{color:var(--ink);font-weight:700}
.ccrow .r{display:flex;align-items:center;gap:9px;margin-top:9px;flex-wrap:wrap}
.ccrow .when{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink-soft)}
.cclink{font-family:"Hanken Grotesk";font-weight:700;font-size:11.5px;color:var(--pos);cursor:pointer;padding:3px 7px;border-radius:8px}
.cclink:active{background:var(--pos-soft)}
.cclink.mut{color:var(--ink-soft)}
.ccinbox{margin-top:10px}
.ccinrow{display:flex;gap:8px}
.ccin{flex:1;padding:11px 13px;border:1px solid var(--line-strong);border-radius:12px;background:var(--paper);font-size:14px;font-family:"Hanken Grotesk";color:var(--ink)}
.ccin::placeholder{color:var(--ink-soft)}
.ccadd{flex:none;padding:0 16px;border-radius:12px;background:var(--pos);color:#fff;font-weight:700;font-size:13px;font-family:"Hanken Grotesk"}
.ccadd:active{filter:brightness(.94)}
.ccitem{display:flex;align-items:center;gap:11px;padding:11px 4px;border-top:1px solid var(--line)}
.ccitem:first-of-type{border-top:none}
.ccitem .tx{flex:1;font-size:14px;line-height:1.4}
.ccitem .tg{font-family:"Space Mono",monospace;font-size:9.5px;color:var(--ink-soft);white-space:nowrap}
.ccdest{font-family:"Hanken Grotesk";font-weight:600;font-size:11.5px;color:var(--pos);background:var(--pos-soft);border:1px solid color-mix(in srgb,var(--pos) 30%,transparent);border-radius:9px;padding:5px 9px;cursor:pointer;white-space:nowrap}
.ccx{color:var(--line-strong);font-size:15px;cursor:pointer;padding:2px 6px}
.ccx:hover{color:var(--neg)}
.ccinbox .cnt{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink-soft);margin-top:11px}
.ccproj{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:var(--paper);margin-top:9px}
.ccproj .body{flex:1;min-width:0}
.ccproj .pn{font-size:14.5px;font-weight:600}
.ccproj .pm{font-family:"Space Mono",monospace;font-size:10.5px;color:var(--ink-soft);margin-top:2px}
.ccstat{font-family:"Space Mono",monospace;font-size:9.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border-radius:20px;white-space:nowrap}
.ccstat.ok{background:var(--pos-soft);color:var(--pos)}
.ccstat.warn{background:#fbeccd;color:#956414}
.ccstat.cold{background:var(--neg-soft);color:var(--neg)}
.ccdot{width:9px;height:9px;border-radius:50%;flex:none}
.ccflow{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.ccflowi{display:flex;align-items:center;gap:8px;background:var(--paper);border:1px solid var(--line);border-radius:11px;padding:8px 12px;font-size:12.5px}
.ccflowi .f{font-family:"Space Mono",monospace;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft)}
.ccflowi .ar{color:var(--pos);font-weight:700}
.ccflowi .to{font-weight:700}
.ccmap{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:12px}
.cctool{border:1px solid var(--line);border-radius:14px;padding:13px;background:var(--paper)}
.cctool .ic{font-size:21px}
.cctool .nm{font-weight:700;font-size:14px;margin-top:6px}
.cctool .fn{font-size:12px;color:var(--ink-soft);line-height:1.45;margin-top:3px}
.cctool .fr{font-family:"Space Mono",monospace;font-size:9.5px;color:var(--pos);margin-top:8px;text-transform:uppercase;letter-spacing:.04em;line-height:1.5}

/* tip cards (Previsão) — mesmo fundo do painel 50·30·20 */
.tipcard{background:linear-gradient(155deg,#f8f4ea,#efe3c9);border:1px solid var(--line-strong);border-radius:16px;padding:15px 17px;margin-top:12px}
.tipcard::before{display:none}

/* Painel Regra 50·30·20 */
.rule503{background:linear-gradient(155deg,#f8f4ea,#efe3c9);border:1px solid var(--line-strong);border-radius:18px;padding:17px 18px}
.rule503 .rhd{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
.rule503 .rt{font-family:"Fraunces",serif;font-size:19px;font-weight:500;display:flex;align-items:baseline;gap:8px}
.rule503 .rt small{font-family:"Space Mono",monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);font-weight:400}
.rule503 .rbase{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink-soft);text-align:right}
.rule503 .rbase b{display:block;font-size:15px;color:var(--ink);font-weight:700}
.r3row{margin-top:15px}
.r3row .r3hd{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
.r3row .r3n{font-size:13.5px;font-weight:700;display:flex;align-items:center;gap:7px}
.r3row .r3n .sw{width:11px;height:11px;border-radius:3px;flex:none}
.r3row .r3n em{font-style:normal;font-family:"Space Mono",monospace;font-size:10px;color:var(--ink-soft);font-weight:400}
.r3row .r3v{font-family:"Space Mono",monospace;font-size:12.5px;font-weight:700}
.r3bar{position:relative;height:24px;border-radius:8px;background:#fff;border:1px solid var(--line);overflow:hidden}
.r3bar i{position:absolute;left:0;top:0;height:100%;opacity:.92;border-radius:7px 0 0 7px;transition:width .45s ease}
.r3bar .mk{position:absolute;top:0;bottom:0;width:2px;background:var(--ink);z-index:2}
.r3foot{display:flex;justify-content:space-between;margin-top:5px;font-size:11px;font-family:"Space Mono",monospace}
.r3foot .tg{color:var(--ink-soft)}
.r3foot .st{font-weight:700}
.r3foot .st.ok{color:var(--pos)} .r3foot .st.over{color:var(--neg)} .r3foot .st.under{color:var(--brass)}
.rule503 .rsum{display:flex;justify-content:space-between;align-items:baseline;margin-top:17px;padding-top:13px;border-top:1px solid var(--line-strong)}
.rule503 .rsum .l{font-size:12.5px;color:var(--ink-soft)}
.rule503 .rsum .v{font-family:"Space Mono",monospace;font-size:19px;font-weight:700}
.rule503 .rnote{font-size:11.5px;color:var(--ink-soft);line-height:1.5;margin-top:10px}
